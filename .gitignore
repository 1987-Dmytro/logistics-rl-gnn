outputs/
# baseline/run summaries (the condensed table lives in the decision record)
/results/

# Phase 8 viz: small PNG/GIF in git (a documented exception to #1 — README assets);
# heavy/generated/CDN-dependent things (folium HTML, mp4, frames) stay out of git.
/docs/**/*.html
/docs/assets/*.mp4
/docs/assets/frames/

# demo.py artefacts (maps/sheet) — outside git (prohibition #1)
/demo_out/

