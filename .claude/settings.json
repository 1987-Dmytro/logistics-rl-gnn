{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/scripts/refresh-hot-cache.py 2>&1 | head -3",
            "timeout": 5000
          },
          {
            "type": "command",
            "command": "cat ${CLAUDE_PROJECT_DIR}/knowledge/hot.md",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/scripts/stale-check.sh",
            "timeout": 3000
          },
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/scripts/context-census.py 2>&1 | head -1",
            "timeout": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/scripts/brain-session-end.py 2>&1 | tail -2",
            "timeout": 15000
          }
        ]
      }
    ]
  }
}
